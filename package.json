{
  "name": "yumdrop-microservices-platform",
  "version": "1.0.0",
  "description": "YumDrop Enterprise Food Delivery & Logistics Microservices Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "jest --config jest.config.json --selectProjects unit",
    "test:e2e": "jest --config jest.config.json --selectProjects e2e",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "start:all": "node scripts/start-all-services.js",
    "verify:loc": "node scripts/verify-loc-count.js",
    "docker:up": "docker-compose -f deploy/docker-compose.yml up -d --build",
    "docker:down": "docker-compose -f deploy/docker-compose.yml down",
    "seed": "node scripts/seed-database.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "microservices",
    "food-delivery",
    "logistics",
    "typescript",
    "docker",
    "kubernetes",
    "event-driven"
  ],
  "author": "YumDrop Engineering",
  "license": "MIT"
}
